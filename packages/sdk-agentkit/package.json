{
  "name": "@lombard.finance/sdk-agentkit",
  "version": "0.1.0",
  "description": "Lombard Action Provider for Coinbase AgentKit — stake, unstake, deposit, redeem, and deploy BTC.b/LBTC via AI agents",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">= 22.14.0"
  },
  "scripts": {
    "types": "tsc --noEmit",
    "build": "yarn types && vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@lombard.finance/sdk": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.2.0",
    "viem": "^2.21.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.2.0",
    "@swc/core": "^1.11.0",
    "typescript": "^5.4.5",
    "unplugin-swc": "^1.5.0",
    "viem": "^2.21.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "zod": "^3.23.0"
  }
}
