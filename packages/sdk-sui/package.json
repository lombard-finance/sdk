{
  "name": "@lombard.finance/sdk-sui",
  "version": "1.1.1",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 22.14.0"
  },
  "scripts": {
    "build-docs": "rimraf ./sdk-docs && typedoc --out sdk-docs",
    "build-storybook": "storybook build -o sdk-storybook",
    "build": "yarn types && vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@bitcoin-js/tiny-secp256k1-asmjs": "2.2.3",
    "axios": "^1",
    "bignumber.js": "^9",
    "bitcoinjs-lib": "6.1.5",
    "web3": "^4"
  },
  "dependencies": {
    "@lombard.finance/sdk-common": "workspace:*",
    "@mysten/sui": "^1.21.1",
    "@mysten/wallet-standard": "^0.13.7",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/core": "^1.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.6.1",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "axios": "1.12.0",
    "bignumber.js": "^9.1.2",
    "rimraf": "^5",
    "storybook": "^8.2.9",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5",
    "vite": "^6.3.5"
  }
}
