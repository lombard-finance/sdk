{
  "name": "@lombard.finance/sdk-starknet",
  "version": "0.3.3",
  "description": "Starknet integration for the Lombard SDK - stake BTC and manage LBTC on Starknet",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 22.14.0"
  },
  "scripts": {
    "build": "yarn types && vite build",
    "build-docs": "rimraf ./sdk-docs && typedoc --out sdk-docs",
    "build-storybook": "storybook build -o sdk-storybook",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "vitest run --config vitest.unit.config.ts",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "storybook": "storybook dev -p 6006",
    "types": "tsc --noEmit",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@lombard.finance/sdk-common": "workspace:*",
    "starknet": "~6.24.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.6.1",
    "@starknet-io/get-starknet": "^4.0.7",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@tanstack/react-query": "^5.71.1",
    "@types/node": "^24.7.2",
    "axios": "^1.7.4",
    "bignumber.js": "^9.1.2",
    "bootstrap": "^5.3.3",
    "rimraf": "^5",
    "storybook": "^8.2.9",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lombard-finance/sdk.git",
    "directory": "packages/sdk-starknet"
  },
  "homepage": "https://docs.lombard.finance",
  "bugs": {
    "url": "https://github.com/lombard-finance/sdk/issues"
  },
  "keywords": [
    "lombard",
    "sdk",
    "starknet",
    "bitcoin",
    "lbtc",
    "staking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noble/hashes": "^1.7.2",
    "axios": "^1",
    "bignumber.js": "^9"
  },
  "resolutions": {
    "starknet": "~6.24.1"
  }
}
