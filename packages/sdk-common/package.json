{
  "name": "@lombard.finance/sdk-common",
  "version": "4.2.0",
  "description": "Shared utilities and types for the Lombard SDK packages",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./utils/*": "./src/utils/*.ts"
  },
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "build-docs": "rimraf ./sdk-docs && typedoc --out sdk-docs",
    "build": "yarn types && vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "types": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lombard-finance/sdk.git",
    "directory": "packages/sdk-common"
  },
  "homepage": "https://docs.lombard.finance",
  "bugs": {
    "url": "https://github.com/lombard-finance/sdk/issues"
  },
  "keywords": [
    "lombard",
    "sdk",
    "common",
    "utilities"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "bitcoinjs-lib": "^6.1.5"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "1.2.0",
    "bitcoinjs-lib": "6.1.5",
    "rimraf": "^5",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5",
    "vite": "^6.3.5"
  }
}
