{
  "name": "@lombard.finance/sdk",
  "version": "3.6.13",
  "dependencies": {
    "@lombard.finance/btc-deposit-addresses": "^1.0.0",
    "@lombard.finance/sdk-common": "^3.0.0",
    "isows": "^1.0.7",
    "viem": "^2.23.15",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@chromatic-com/storybook": "1.6.1",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@tanstack/react-query": "^5.71.1",
    "axios": "^1.7.4",
    "bignumber.js": "^9.1.2",
    "bootstrap": "^5.3.3",
    "rimraf": "^5",
    "storybook": "^8.2.9",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4",
    "wagmi": "^2.14.15"
  },
  "engines": {
    "node": ">= 22.14.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./clients/*": "./src/clients/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@layerzerolabs/lz-v2-utilities": "3.0.17",
    "axios": "^1",
    "bignumber.js": "^9",
    "bitcoinjs-lib": "6.1.5"
  },
  "scripts": {
    "build": "yarn types && vite build",
    "build-docs": "rimraf ./sdk-docs && typedoc --out sdk-docs",
    "build-storybook": "storybook build -o sdk-storybook",
    "format": "biome format",
    "lint": "biome lint --diagnostic-level=error",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "types": "tsc --noEmit",
    "watch": "vite build --watch"
  },
  "type": "module",
  "types": "./src/index.ts"
}
