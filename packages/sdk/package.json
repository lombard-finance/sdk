{
  "name": "@lombard.finance/sdk",
  "version": "4.5.1",
  "description": "TypeScript SDK for the Lombard protocol - stake BTC, mint LBTC, and interact with DeFi",
  "dependencies": {
    "@lombard.finance/sdk-common": "workspace:*",
    "isows": "^1.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.6.1",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "@tanstack/react-query": "^5.71.1",
    "@vitest/ui": "3.2.4",
    "axios": "1.12.0",
    "bignumber.js": "^9.1.2",
    "bootstrap": "^5.3.3",
    "rimraf": "^5",
    "storybook": "^8.2.9",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wagmi": "^2.14.15"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./api": {
      "types": "./dist/entries/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.cjs"
    },
    "./contracts": {
      "types": "./dist/entries/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./btc": {
      "types": "./dist/entries/btc.d.ts",
      "import": "./dist/btc.js",
      "require": "./dist/btc.cjs"
    },
    "./evm": {
      "types": "./dist/entries/evm.d.ts",
      "import": "./dist/evm.js",
      "require": "./dist/evm.cjs"
    },
    "./metrics": {
      "types": "./dist/entries/metrics.d.ts",
      "import": "./dist/metrics.js",
      "require": "./dist/metrics.cjs"
    },
    "./utils": {
      "types": "./dist/entries/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./vaults": {
      "types": "./dist/entries/vaults.d.ts",
      "import": "./dist/vaults.js",
      "require": "./dist/vaults.cjs"
    },
    "./defi": {
      "types": "./dist/entries/defi.d.ts",
      "import": "./dist/defi.js",
      "require": "./dist/defi.cjs"
    },
    "./bridge": {
      "types": "./dist/entries/bridge.d.ts",
      "import": "./dist/bridge.js",
      "require": "./dist/bridge.cjs"
    },
    "./debug": {
      "types": "./dist/entries/debug.d.ts",
      "import": "./dist/debug.js",
      "require": "./dist/debug.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/lombard-finance/sdk"
  },
  "homepage": "https://docs.lombard.finance",
  "bugs": {
    "url": "https://github.com/lombard-finance/sdk/issues"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "lombard",
    "sdk",
    "bitcoin",
    "lbtc",
    "staking",
    "defi",
    "btc"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@layerzerolabs/lz-v2-utilities": "^3.0.17",
    "axios": "^1",
    "bignumber.js": "^9",
    "bitcoinjs-lib": "^6.1.5",
    "viem": "^2.21.0"
  },
  "scripts": {
    "build": "yarn types && vite build && yarn build-types",
    "build-docs": "rimraf ./sdk-docs && typedoc --out sdk-docs",
    "build-storybook": "storybook build -o sdk-storybook",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "storybook": "storybook dev -p 6006",
    "test": "yarn test:unit && yarn test:integration:mocked",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "yarn test:integration:mocked",
    "test:integration:mocked": "vitest run --config vitest.integration.config.ts",
    "test:integration:online": "ENABLE_ONLINE_INTEGRATION=true ENABLE_CONTRACT_CHECKS=true vitest run --config vitest.integration.online.config.ts",
    "test:all": "yarn test:unit && yarn test:integration:mocked && yarn test:integration:online",
    "test:generate-wallets": "ts-node scripts/generate-test-wallets.ts",
    "test:check-balances": "ts-node scripts/prefund-test-wallets.ts",
    "types": "tsc --noEmit",
    "build-types": "tsc -b tsconfig.build.json",
    "watch": "vite build --watch"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "./dist/entries/core.d.ts"
      ],
      "api": [
        "./dist/entries/api.d.ts"
      ],
      "contracts": [
        "./dist/entries/contracts.d.ts"
      ],
      "btc": [
        "./dist/entries/btc.d.ts"
      ],
      "evm": [
        "./dist/entries/evm.d.ts"
      ],
      "metrics": [
        "./dist/entries/metrics.d.ts"
      ],
      "utils": [
        "./dist/entries/utils.d.ts"
      ],
      "vaults": [
        "./dist/entries/vaults.d.ts"
      ],
      "defi": [
        "./dist/entries/defi.d.ts"
      ],
      "bridge": [
        "./dist/entries/bridge.d.ts"
      ],
      "debug": [
        "./dist/entries/debug.d.ts"
      ]
    }
  }
}
