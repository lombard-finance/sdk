{
  "name": "@lombard.finance/sdk-react",
  "version": "0.1.0",
  "description": "React hooks for the Lombard SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn types && vite build",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@lombard.finance/sdk": "workspace:*",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@lombard.finance/sdk": "workspace:*",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^3.2.4"
  },
  "homepage": "https://docs.lombard.finance",
  "bugs": {
    "url": "https://github.com/lombard-finance/sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lombard-finance/sdk.git",
    "directory": "packages/sdk-react"
  },
  "keywords": [
    "lombard",
    "sdk",
    "react",
    "hooks",
    "bitcoin",
    "lbtc",
    "staking"
  ],
  "license": "MIT"
}
