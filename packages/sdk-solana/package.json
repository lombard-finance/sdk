{
  "name": "@lombard.finance/sdk-solana",
  "version": "2.0.0",
  "description": "Solana integration for the Lombard SDK - stake BTC and manage LBTC on Solana",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 22.14.0"
  },
  "scripts": {
    "types": "tsc --noEmit",
    "build": "yarn types && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o sdk-storybook",
    "build-docs": "rimraf ./sdk-docs && typedoc --out sdk-docs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:turbo": "cd ../.. && turbo run test --filter=@lombard.finance/sdk-solana"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lombard-finance/sdk.git",
    "directory": "packages/sdk-solana"
  },
  "homepage": "https://docs.lombard.finance",
  "bugs": {
    "url": "https://github.com/lombard-finance/sdk/issues"
  },
  "keywords": [
    "lombard",
    "sdk",
    "solana",
    "bitcoin",
    "lbtc",
    "staking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "axios": "^1",
    "bignumber.js": "^9"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@layerzerolabs/lz-definitions": "^3.0.87",
    "@layerzerolabs/lz-v2-utilities": "^3.0.87",
    "@layerzerolabs/oft-v2-solana-sdk": "^3.0.87",
    "@lombard.finance/sdk-common": "workspace:*",
    "@metaplex-foundation/umi": "^0.9.2",
    "@metaplex-foundation/umi-bundle-defaults": "^0.9.2",
    "@metaplex-foundation/umi-signer-wallet-adapters": "^0.9.2",
    "@metaplex-foundation/umi-web3js-adapters": "^0.9.2",
    "@solana/spl-token": "^0.3.8",
    "@solana/web3.js": "~1.95.8",
    "bignumber.js": "^9.1.2",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "encoding": "^0.1.13",
    "js-sha256": "^0.11.0",
    "js-sha3": "^0.9.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.6.1",
    "@storybook/addon-essentials": "^8.2.9",
    "@storybook/addon-interactions": "^8.2.9",
    "@storybook/addon-links": "^8.2.9",
    "@storybook/addon-onboarding": "^8.2.9",
    "@storybook/blocks": "^8.2.9",
    "@storybook/react": "^8.2.9",
    "@storybook/react-vite": "^8.2.9",
    "@storybook/test": "^8.2.9",
    "axios": "1.12.0",
    "bootstrap": "^5.3.2",
    "buffer": "^6.0.3",
    "rimraf": "^5",
    "storybook": "^8.2.9",
    "typedoc": "^0.26.6",
    "typescript": "^5.4.5",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^3.4.0",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "@solana/web3.js": "~1.95.8"
  }
}
