# Anthropic API key (used by the /api/chat serverless function)
ANTHROPIC_API_KEY=sk-ant-...

# WalletConnect project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# Lombard partner ID for BTC deposit address generation.
# Testnet and mainnet have separate partner registries on the BFF.
# Mainnet partners: okx, lombard
# Testnet partners: test1, test2, ..., test10
# Defaults if unset: mainnet -> "okx", testnet -> "test1".
# The header selector in the chat UI overrides these at runtime.
VITE_LOMBARD_PARTNER_ID=
VITE_LOMBARD_TESTNET_PARTNER_ID=
LOMBARD_PARTNER_ID=
LOMBARD_TESTNET_PARTNER_ID=
