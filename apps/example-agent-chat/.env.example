# ═══════════════════════════════════════════════════════════════════
# Mode 1: Direct Anthropic API (local dev, server deployments)
# ═══════════════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-...

# ═══════════════════════════════════════════════════════════════════
# Mode 2: Proxy mode (route through a server that holds the API key)
# Set API_URL to an Anthropic-compatible endpoint. The server will
# call this URL instead of api.anthropic.com.
# ═══════════════════════════════════════════════════════════════════
# API_URL=https://your-proxy-server.vercel.app
# API_BYPASS_TOKEN=your-vercel-protection-bypass-token

# ═══════════════════════════════════════════════════════════════════
# Frontend config
# ═══════════════════════════════════════════════════════════════════
# WalletConnect project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# API URL override for the chat endpoint (default: /api/chat via Vite proxy)
# Set when the Express server is deployed separately from the frontend
# VITE_API_URL=https://your-api-server.com/api/chat
