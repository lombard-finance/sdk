# Anthropic API key (used by the /api/chat serverless function)
ANTHROPIC_API_KEY=sk-ant-...

# WalletConnect project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your-project-id

# Lombard partner ID for BTC deposit address generation
# Required to generate deposit addresses. Get from Lombard team.
VITE_LOMBARD_PARTNER_ID=
LOMBARD_PARTNER_ID=
