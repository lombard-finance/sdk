# Anthropic API key for the LLM
ANTHROPIC_API_KEY=sk-ant-...

# EVM private key (0x-prefixed). Generate a fresh testnet key, never use a key with real funds.
WALLET_PRIVATE_KEY=0x...

# Network: ethereum-sepolia (testnet) or ethereum-mainnet
NETWORK_ID=ethereum-sepolia

# Optional: custom RPC URL (uses public RPC if omitted)
# RPC_URL=https://...
